# Model weights and local caches must not be committed (CI fails if they are).
# load_model() writes named checkpoints to ~/.cache/whisper or
# $XDG_CACHE_HOME/whisper. --model_dir / download_root can point inside
# this checkout. Hugging Face Hub caches are also ignored.
