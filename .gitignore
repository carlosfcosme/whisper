# Project-local cache and weight dumps stay untracked.
# load_model() writes named checkpoints to ~/.cache/whisper or
# $XDG_CACHE_HOME/whisper (whisper/__init__.py). --model_dir /
# download_root can point inside this checkout. A local weights/
# directory is also ignored so checkpoints stay out of git.
